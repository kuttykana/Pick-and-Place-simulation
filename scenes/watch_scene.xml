<mujoco model="scene">
    <compiler meshdir="meshes/" texturedir="meshes/" />
<option timestep="0.002" integrator="implicitfast" gravity="0 0 -9.81" noslip_iterations="3" impratio="10" cone="elliptic"/>
<include file="so101_new_calib.xml" />
<include file="meshes/watch_case_visual/watch_case_visual.xml" />

<!-- Stiffer default contact for all geoms in this scene -- matches the
     reference pick-101 config, needed alongside impratio for stable grasps. -->
<default>
    <geom solref="0.005 1" solimp="0.99 0.99 0.001"/>
</default>

<visual>
<headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0" />
<rgba haze="0.15 0.25 0.35 1" />
<global azimuth="160" elevation="-20" />
</visual>

<asset>
<texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512"
height="3072" />
<texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4"
rgb2="0.1 0.2 0.3"
markrgb="0.8 0.8 0.8" width="300" height="300" />
<material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5"
reflectance="0.2" />

<!-- Cube object material: plain color, no texture needed for a primitive shape -->
<material name="cube_material" rgba="0.85 0.2 0.2 1" />
</asset>

<worldbody>
<light pos="0 0 3.5" dir="0 0 -1" directional="true" />
<geom name="floor" size="0 0 0.05" pos="0 0 0" type="plane" material="groundplane" />

<!-- Tray surface -->
<geom name="tray" type="box" size="0.15 0.15 0.005" pos="0.23 0 0.01" rgba="0.5 0.5 0.55 1"/>

<!-- Watch case is now provided entirely by the include above:
     visual + 12-part collision + freejoint + inertial, all pipeline-generated. -->

<!-- ============================================================ -->
<!-- Cube object: a fully dynamic, graspable primitive box.        -->
<!-- No mesh/OBJ needed -- MuJoCo's native "box" geom type IS the  -->
<!-- collision AND visual geometry here, generated analytically.   -->
<!-- Since it's a primitive (not a mesh), there's no convex hull   -->
<!-- approximation issue at all -- physics on a box is exact.      -->
<!--                                                                -->
<!-- SIZE CHANGE: shrunk from 4cm to 3cm cube (size 0.02 -> 0.015). -->
<!-- The SO-101's gripper stroke was very likely maxing out against -->
<!-- a 4cm object before generating real squeeze force -- this      -->
<!-- matches the reference pick-101 repo's cube, whose comment      -->
<!-- explicitly says "sized to fit gripper gap".                    -->
<!-- Mass also reduced to 30g and friction/inertia recalculated to  -->
<!-- match. Note friction is LOWER than our earlier attempt --      -->
<!-- impratio=10 + stiff solref/solimp above do the real work now,  -->
<!-- not high friction coefficients.                                -->
<!-- ============================================================ -->
<body name="cube_object" pos="0.2 -0.05 0.015">
    <!-- freejoint: lets the cube move/fall/be picked up under full 6-DOF physics.
         Remove this line if you want it static like target_object currently is. -->
    <freejoint/>

    <!-- inertial: explicit mass + diagonal inertia for a uniform solid cube.
         For a solid cube of side length s and mass m: I = (1/6) * m * s^2.
         s = 0.03 m, m = 0.03 kg -> I = (1/6) * 0.03 * 0.03^2 = 4.5e-6 -->
    <inertial pos="0 0 0" mass="0.03" diaginertia="4.5e-6 4.5e-6 4.5e-6"/>

    <!-- geom: type="box", size is HALF-extents -> size="0.015 0.015 0.015" = 3cm cube. -->
    <geom name="cube_object_geom" type="box" size="0.015 0.015 0.015"
          material="cube_material"
          friction="0.5 0.05 0.001"/>
</body>

<!-- Place bin: floor + 4 walls, small container -->
<body name="place_bin" pos="0.13 0.12 0.015">
    <geom name="bin_floor" type="box" size="0.035 0.035 0.003" pos="0 0 0.003" rgba="0.3 0.3 0.35 1"/>
    <geom name="bin_wall_x1" type="box" size="0.003 0.035 0.015" pos="0.035 0 0.015" rgba="0.3 0.3 0.35 1"/>
    <geom name="bin_wall_x2" type="box" size="0.003 0.035 0.015" pos="-0.035 0 0.015" rgba="0.3 0.3 0.35 1"/>
    <geom name="bin_wall_y1" type="box" size="0.035 0.003 0.015" pos="0 0.035 0.015" rgba="0.3 0.3 0.35 1"/>
    <geom name="bin_wall_y2" type="box" size="0.035 0.003 0.015" pos="0 -0.035 0.015" rgba="0.3 0.3 0.35 1"/>
</body>

</worldbody>
</mujoco>